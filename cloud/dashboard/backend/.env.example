APP_ENV=production
JWT_SECRET=<generate-at-least-32-random-characters>
DB_HOST=localhost
DB_PORT=3306
DB_USER=<deployment-user>
DB_PASSWORD=<deployment-secret>
DB_NAME=smart_campus_db
DEVICE_CREDENTIAL_KEY=<fernet-key-from-secret-storage>
DASHBOARD_ORIGINS=https://dashboard.example.edu
TRUSTED_PROXY_IPS=
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
PRIVATE_STORAGE_ROOT=/var/lib/smart-campus/private
COOKIE_SECURE=true
MAX_DOCUMENT_BYTES=26214400
MAX_BIOMETRIC_BYTES=10485760
MAX_SURVEILLANCE_BYTES=10485760
MAX_AI_CONCURRENCY=8
