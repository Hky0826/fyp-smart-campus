# =============================================================================
# Access Control Module Configuration (.env.example)
# =============================================================================

# Normal first-time setup is completed in the device UI. These values are
# advanced fallback settings; the UI-managed runtime file is stored outside
# the repository at ~/.smart-campus-edge/device_runtime.env.

# System, Server & Camera Settings
# Camera source: "auto" (default: auto-detects CSI IMX219 on Raspberry Pi 5, falls back to USB /dev/video*),
# or explicitly set: "csi", "csi:0", "/dev/video4", "0", or RTSP stream URL
EDGE_CAMERA=auto
EDGE_LOG_LEVEL=INFO
# Leave blank to use the external default: ~/.smart-campus-edge/device_local.db
EDGE_DB_PATH=

# API Backend Server Settings
ACCESS_API_HOST=127.0.0.1
ACCESS_API_PORT=8080

# Feature Toggles
EDGE_RECOGNITION_ENABLED=true
EDGE_ACCESS_CONTROL_ENABLED=true
EDGE_SYNC_ENABLED=true

# Model Paths & Settings (YuNet Detector & SFace Recognizer)
EDGE_ACCESS_DETECTOR_MODEL_PATH=models/access_control/face_detection_yunet_2023mar_int8bq.onnx
EDGE_ACCESS_EMBEDDING_MODEL_PATH=models/access_control/face_recognition_sface_2021dec.onnx
EDGE_ACCESS_DETECTOR_TYPE=yunet
EDGE_ACCESS_EMBEDDER_TYPE=sface
EDGE_ACCESS_RECOGNITION_MODEL_NAME=openvc_sface

# Biometric & Quality Thresholds
EDGE_ACCESS_DETECTION_THRESHOLD=0.60
EDGE_ACCESS_RECOGNITION_THRESHOLD=0.363
EDGE_ACCESS_RECOGNITION_DELAY_SECONDS=1.0
EDGE_ACCESS_MIN_FACE_SIZE=48
EDGE_ACCESS_MIN_INTER_EYE_DISTANCE=18.0
EDGE_ACCESS_NMS_IOU_THRESHOLD=0.30

# Multi-frame Embedding Aggregation
EDGE_ACCESS_MIN_EMBEDDING_SAMPLES=3
EDGE_ACCESS_MAX_EMBEDDING_SAMPLES=15
EDGE_ACCESS_EMBEDDING_OUTLIER_THRESHOLD=0.25
EDGE_ACCESS_CANDIDATE_CONSISTENCY_RATIO=0.65

# Face Tracking
EDGE_ACCESS_MIN_STABLE_FRAMES=5
EDGE_ACCESS_MIN_STABLE_DURATION_MS=250
EDGE_ACCESS_MAX_MISSED_FRAMES=3
EDGE_ACCESS_TRACK_TIMEOUT_MS=1000
EDGE_ACCESS_MIN_IOU_FOR_MATCH=0.30
EDGE_ACCESS_MAX_LANDMARK_JUMP_RATIO=0.50

# Anti-Spoofing & Liveness
EDGE_ACCESS_REQUIRE_LIVENESS=true

# Cloud Synchronization
EDGE_SYNC_CLOUD_URL=https://cloud.example.invalid
EDGE_SYNC_DEVICE_ID=entry-gate-01
EDGE_SYNC_DEVICE_SECRET=
EDGE_SYNC_DEVICE_NAME=North Entry Gate Kiosk
EDGE_SYNC_LOCAL_IP=127.0.0.1
EDGE_SYNC_LOCAL_PORT=8001
EDGE_SYNC_DOWNSTREAM_POLL_SECONDS=30
EDGE_SYNC_LOG_PUSH_INTERVAL_SECONDS=60

# Voice Chatbot & Audio Coordinator
EDGE_ACCESS_AUDIO_ENABLED=true
EDGE_ACCESS_AUDIO_SKIP_MODEL_SETUP=false
EDGE_ACCESS_AUDIO_AUTH_TIMEOUT_SECONDS=45
EDGE_ACCESS_AUDIO_TOKEN_REFRESH_SECONDS=600
EDGE_ACCESS_AUDIO_TOKEN_RETRY_SECONDS=10
EDGE_ACCESS_CHATBOT_AUTO_VISITOR_TOKEN=false
EDGE_ACCESS_CHATBOT_VISITOR_USER_ID=

# Snapshot & Logging Storage
EDGE_ACCESS_SNAPSHOT_ENABLED=false
EDGE_ACCESS_SNAPSHOT_DIR=data/snapshots
EDGE_ACCESS_SNAPSHOT_RETENTION_DAYS=7
EDGE_ACCESS_PAD_MODEL_PATH=
EDGE_ACCESS_PAD_MODEL_VERSION=
EDGE_ACCESS_PAD_REQUIRED=true
EDGE_ALLOW_INSECURE_LOOPBACK=false
EDGE_REMOTE_API_ENABLED=false
EDGE_INSTALLATION_CREDENTIAL=
EDGE_DB_ENCRYPTION_KEY=
