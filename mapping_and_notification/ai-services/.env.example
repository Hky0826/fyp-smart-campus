# ──────────────────────────────────────────────────────────────────────────────
# AI Services — Environment Variables Template
# Copy to .env and fill in values before running the service.
# ──────────────────────────────────────────────────────────────────────────────

# Service identity
APP_NAME=campus-ai-services
APP_VERSION=1.0.0
APP_ENV=development          # development | production

# Server
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# CORS — comma-separated allowed origins (Node.js backend + React frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Wall detection defaults (must match frontend mapConstants.js)
DEFAULT_CANVAS_WIDTH=800
DEFAULT_CANVAS_HEIGHT=600
DEFAULT_GRID_SCALE=8
DEFAULT_WALL_SENSITIVITY=120
