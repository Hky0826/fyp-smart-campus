DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=campus_navigation

RABBITMQ_URL=

JWT_SECRET=
NAVIGATION_API_KEY=
# ─── Email Delivery ───────────────────────────────────────────────────────────
# Set EMAIL_MODE to 'ethereal' for local development (captured inbox, no real delivery)
# or 'smtp' to use a real SMTP provider for production.
EMAIL_MODE=ethereal

# Real SMTP provider (used when EMAIL_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Route Visualization ─────────────────────────────────────────────────────
# How long (in hours) to retain generated route visualization images before cleanup.
VISUALISATION_RETENTION_HOURS=24

# ─── Mobile Wayfinding & QR Code (VS Code Dev Tunnel) ────────────────────────
# Set MOBILE_BASE_URL to your public VS Code Dev Tunnel address (or public domain)
# e.g., https://xxxx-5000.asse.devtunnels.ms
MOBILE_BASE_URL=
KIOSK_SESSION_TTL_MINUTES=15
