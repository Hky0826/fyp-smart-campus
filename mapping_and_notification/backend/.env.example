DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=campus_navigation

RABBITMQ_URL=

JWT_SECRET=
NAVIGATION_API_KEY=
# ─── Email Delivery ───────────────────────────────────────────────────────────
# Set EMAIL_MODE to 'ethereal' for local development (captured inbox, no real delivery)
# or 'smtp' to use a real SMTP provider for production.
EMAIL_MODE=ethereal

# Real SMTP provider (used when EMAIL_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Route Visualization ─────────────────────────────────────────────────────
# How long (in hours) to retain generated route visualization images before cleanup.
VISUALISATION_RETENTION_HOURS=24

# ─── AI Microservice ─────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=30000
